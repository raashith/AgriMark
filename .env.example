# AgriMark Environment Configuration Template
# COPY THIS FILE TO .env AND FILL IN ENVIRONMENT-SPECIFIC VALUES
# DO NOT COMMIT ACTUAL SECRETS OR PRIVATE KEYS TO SOURCE CONTROL

# Application Environment Settings
PROJECT_NAME="AgriMark National Agricultural Operating System"
ENVIRONMENT="development"
DEBUG=true
API_V1_STR="/api/v1"

# JWT Authentication & Security
SECRET_KEY="your-random-32-byte-secret-key-here"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=43200

# CORS Configuration
CORS_ORIGINS="http://localhost:3000,http://localhost:8000,http://127.0.0.1:3000"

# Database & Supabase Connections (MySQL Production / SQLite Dev Fallback)
DATABASE_URL="mysql+pymysql://agrimark_user:agrimark_password@localhost:3306/agrimark_db"
TEST_DATABASE_URL="sqlite:///:memory:"
SUPABASE_URL="https://your-supabase-project.supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key-here"

# Server-Side AI & Model Credentials (NEVER EXPOSE TO CLIENT/ANDROID)
OPENAI_API_KEY="your-openai-api-key-here"
OPENAI_MODEL="gpt-4o"

# External Agricultural Data Providers
IMD_WEATHER_API_KEY="your-imd-api-key-here"
ENAM_MARKET_API_KEY="your-enam-api-key-here"
ISRO_SATELLITE_API_KEY="your-isro-api-key-here"
GOOGLE_MAPS_API_KEY="your-google-maps-api-key-here"

# Storage Configuration (S3 / GCS / Local)
STORAGE_PROVIDER="local"
STORAGE_BUCKET_NAME="agrimark-storage-bucket"
AWS_ACCESS_KEY_ID="your-aws-access-key-id"
AWS_SECRET_ACCESS_KEY="your-aws-secret-access-key"

# Redis & Cache Configuration
REDIS_URL="redis://localhost:6379/0"
CACHE_ENABLED=true

# Observability & Monitoring
SENTRY_DSN="your-sentry-dsn-here"
LOG_LEVEL="INFO"

# Abstract Payment & Ledger Providers
PAYMENT_PROVIDER_MODE="sandbox"
PAYMENT_GATEWAY_KEY="your-payment-gateway-key-here"

# Abstract Logistics Providers
LOGISTICS_PROVIDER_MODE="sandbox"
LOGISTICS_API_KEY="your-logistics-api-key-here"
