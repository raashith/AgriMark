# AgriMark Production Environment Variable Reference

# Application & Environment
PROJECT_NAME="AgriMark Backend API"
VERSION="1.0.0"
API_V1_STR="/api/v1"
ENV="production" # production, staging, development
DATABASE_ENV="production" # production, development
DEBUG=False

# Primary Database: PostgreSQL / Supabase
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"
SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
SUPABASE_ANON_KEY="[YOUR-SUPABASE-ANON-KEY]"
SUPABASE_SERVICE_ROLE_KEY="[YOUR-SUPABASE-SERVICE-ROLE-KEY]"
TEST_DATABASE_URL="sqlite:///:memory:"

# JWT Security
SECRET_KEY="[YOUR-STRONG-RANDOM-SECRET-KEY-64-CHAR]"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS="https://app.agrimark.in,https://admin.agrimark.in"

# External Data APIs
AGMARKNET_API_KEY="[YOUR-AGMARKNET-API-KEY]"
WEATHER_API_KEY="[YOUR-WEATHER-API-KEY]"

# AI Model Configuration
GEMINI_API_KEY="[YOUR-GEMINI-API-KEY]"
