# AgriMark Canonical Environment Configuration Template
# COPY THIS FILE TO .env AND SET ACCORDING TO YOUR ENVIRONMENT
# DO NOT COMMIT ACTUAL SECRETS OR PRIVATE KEYS TO SOURCE CONTROL

# APP Settings
APP_NAME="AgriMark National Agricultural Operating System"
APP_ENV="development"
APP_DEBUG=true
APP_API_V1_STR="/api/v1"

# DATABASE Settings (PostgreSQL Production / SQLite Fallback)
DATABASE_URL="postgresql://postgres:postgres_pass@localhost:5432/agrimark_db"
DATABASE_TEST_URL="sqlite:///:memory:"

# SUPABASE Settings
SUPABASE_URL="https://your-supabase-project.supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key-here"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key-here"

# JWT Security
JWT_SECRET_KEY="your-random-32-byte-secret-key-here"
JWT_ALGORITHM="HS256"
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=43200

# OPENAI Server-Side AI Settings
OPENAI_API_KEY="your-openai-api-key-here"
OPENAI_MODEL="gpt-4o"

# REDIS Cache & Event Bus
REDIS_URL="redis://localhost:6379/0"
REDIS_CACHE_ENABLED=true

# STORAGE Configuration (S3 / GCS / Local)
STORAGE_PROVIDER="local"
STORAGE_BUCKET_NAME="agrimark-storage-bucket"

# AGMARKNET & Market Data Providers
AGMARKNET_API_KEY="your-agmarknet-api-key-here"
DATA_GOV_API_KEY="your-datagov-api-key-here"

# IMD Weather Data Provider
IMD_WEATHER_API_KEY="your-imd-api-key-here"

# PAYMENT Abstract Providers
PAYMENT_PROVIDER_MODE="sandbox"
PAYMENT_GATEWAY_KEY="your-payment-gateway-key-here"

# LOGISTICS Abstract Providers
LOGISTICS_PROVIDER_MODE="sandbox"
LOGISTICS_API_KEY="your-logistics-api-key-here"

# OBSERVABILITY & Monitoring
OBSERVABILITY_SENTRY_DSN="your-sentry-dsn-here"
OBSERVABILITY_LOG_LEVEL="INFO"
