# AgriMark Backend Environment Configuration

PROJECT_NAME="AgriMark Backend API"
API_V1_STR="/api/v1"
ENV="development"
DEBUG=True

# Database Configuration
# Default MySQL Connection String: mysql+pymysql://user:password@localhost:3306/agrimark_db
DATABASE_URL="mysql+pymysql://agrimark:agrimark_pass@localhost:3306/agrimark_db"
TEST_DATABASE_URL="sqlite:///:memory:"

# JWT Security
SECRET_KEY="agrimark_super_secret_jwt_key_change_in_production_environment_12345"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS Allowed Origins (comma separated)
CORS_ORIGINS="http://localhost:3000,http://localhost:8000,http://127.0.0.1:3000"
